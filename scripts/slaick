@cli.command("dm")
@click.argument("user")
@click.argument("text", required=False)
@click.option(
    "--file",
    "file_paths",
    multiple=True,
    type=click.Path(exists=True, dir_okay=False, path_type=Path),
    help="File path to upload. May be used more than once.",
)
@click.option("--thread-ts", help="Optional thread timestamp.")
@click.pass_obj
def command_direct_message(
    command_context: SlaickContext,
    user: str,
    text: str | None,
    file_paths: tuple[Path, ...],
    thread_ts: str | None,
) -> None:
    """Send a direct message."""
    message_text = get_message_text(text, require_text=not file_paths)
    send_message(command_context, f"@{user.removeprefix('@')}", message_text, thread_ts, file_paths)


@cli.command("logout")
@click.pass_obj
def command_logout(command_context: SlaickContext) -> None:
    """Remove cached token."""
    delete_cached_token()
    click.echo(f"Deleted cached token: `{TOKEN_CACHE_PATH}`")


@cli.command("clear-cache")
@click.pass_obj
def command_clear_cache(command_context: SlaickContext) -> None:
    """Clear and rebuild workspace cache."""
    workspace_cache_directory = get_workspace_cache_directory(command_context)
    if workspace_cache_directory.exists():
        shutil.rmtree(workspace_cache_directory)
    authentication = call_with_refresh(command_context, "auth_test")
    cache_user_id_from_authentication(command_context, authentication)
    with ensure_user_cache(command_context):
        pass
    with ensure_conversation_cache(command_context):
        pass
    click.echo(f"Rebuilt workspace cache: `{workspace_cache_directory}`")


@cli.command("set-workspace")
@click.argument("workspace_value", metavar="workspace")
@click.pass_obj
def command_set_workspace(command_context: SlaickContext, workspace_value: str) -> None:
    """Store default workspace."""
    workspace_url = normalize_workspace_url(workspace_value)
    write_configured_workspace(workspace_url)
    delete_cached_token()
    output_lines(
        [
            f"Workspace set to {workspace_url}",
            f"Config: `{WORKSPACE_CONFIG_PATH}`",
            "Cached token cleared.",
        ],
    )


if __name__ == "__main__":
    cli()
